<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.hotel_back.mapper.AdminMapper">
    <select id="employeePageQuery" resultType="Employee">
        SELECT * FROM employee
        <where>
            role_id!=1
            <if test="realName != null and realName != ''">
                AND real_name LIKE CONCAT('%', #{realName}, '%')
            </if>
            <if test="empNo != null and empNo != ''">
                AND emp_no = #{empNo}
            </if>
            <if test="roleId != null">
                AND role_id = #{roleId}
            </if>
            <if test="startDate != null">
                AND create_time >= STR_TO_DATE(#{startDate}, '%Y-%m-%d')
            </if>
            <if test="endDate != null">
                AND create_time &lt; DATE_ADD(STR_TO_DATE(#{endDate}, '%Y-%m-%d'), INTERVAL 1 DAY)
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>
    <update id="adminUpdate" parameterType="Employee">
        update employee
        <set>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="username != null">username = #{username},</if>
            update_time = NOW()
        </set>
        where id = #{id}
    </update>
    <update id="updatePassword" parameterType="Employee">
        update employee
        set password = #{password},
            update_time = NOW()
        where id = #{id}
    </update>
    <update id="updateEmployee" parameterType="Employee">
        update employee
        <set>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="roleId != null">role_id = #{roleId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="password != null and password !=''">password = #{password},</if>
            update_time = NOW()
        </set>
        where id = #{id}
    </update>
